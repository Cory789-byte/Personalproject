{
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "legal_system/output/site": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "legal_system/output/site": true,
    "legal_system/output/data.json": true
  },
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "python.analysis.extraPaths": [
    "legal_system"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false
}
